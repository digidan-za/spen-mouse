{
  "folders": [
    {
      "name": "spen-mouse",
      "path": "."
    }
  ],
  "settings": {
    "window.title": "spen-mouse — ${activeEditorShort}",
    "files.exclude": {
      "**/*.code-workspace": true,
      "**/bin": true,
      "**/obj": true,
      "**/build": true,
      "**/.gradle": true,
      "**/.idea": true
    },
    "editor.minimap.enabled": false,
    "workbench.startupEditor": "none",
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#1428A0",
      "titleBar.activeForeground": "#FFFFFF",
      "titleBar.inactiveBackground": "#1428A0CC",
      "titleBar.inactiveForeground": "#FFFFFFCC"
    }
  }
}
